node_modules/
dist/
build/
*.log
.env
.env.*
!.env.example
# 実行中のデータ（アカウント・会話の記録・添付・壁紙・拡張機能のデータ）は全部リポジトリに入れない
data/**
!data/.gitkeep
config/homelab-hosts.json
config/homeassistant.json
# 応答パネルのVRMアバター。第三者のモデルを置く想定（再配布禁止のものも多い）なのでリポジトリに含めない
config/*.vrm
# ウェイクワードごとのキャラクター（プロンプト・VRMは個人のもの。形式は config/voice-personas.example/）
config/voice-personas/
.DS_Store

# 背景画像は第三者の著作物を置く想定なのでリポジトリには含めない。
# apps/web/public/background.jpg に好きな画像を置くと背景になる（無ければグラデーションにフォールバック）。
apps/web/public/background.jpg

# 音声エージェント（Python）の仮想環境とキャッシュ
apps/voice-agent/.venv/
__pycache__/
*.egg-info/

# 拡張機能のビルド道具が作る ZIP（scripts/build-extension.mjs --zip）
extensions/*/*.zip
examples/extensions/*/*.zip

# 移行の道具（scripts/migrate.mjs）が作る・残すもの
.migrate-import-*/
*.before-import-*
*.hdmigrate
home-dashboard-*.tar.gz
