PORT=8787

# 天気ウィジェット（Open-Meteo、APIキー不要）
WEATHER_LAT=35.6895
WEATHER_LON=139.6917
WEATHER_LOCATION_NAME=Tokyo

# Spotifyメディアウィジェット
# SpotifyはRedirect URIに https か、リテラルの 127.0.0.1（localhostは不可）以外を許可しない。
# サーバーをリモートホスト(gco等)で動かす場合、初回認可のときだけSSHポートフォワードで
# ローカルの127.0.0.1経由にするのが手軽（詳細はREADMEの「Spotify連携のセットアップ」参照）。
# 1. https://developer.spotify.com/dashboard でアプリを作成し、
#    Redirect URI に SPOTIFY_REDIRECT_URI と同じ値(http://127.0.0.1:8787/auth/spotify/callback)を登録する
# 2. CLIENT_ID/SECRET/REDIRECT_URIを設定してサーバーを起動
# 3. `ssh -L 8787:localhost:8787 gco` 等でトンネルしてから、
#    手元のブラウザで http://127.0.0.1:8787/auth/spotify/login を開いて認可
# 4. 届いたrefresh tokenはサーバーが data/connections.json に保存してすぐ使う（ここに書き写さなくてよい）
#    Spotify・Home Assistant・メール・天気は設定画面の「接続設定」からも変えられ、そちらが優先される
#    （以降はトンネル不要。refresh tokenはSpotifyがrevokeしない限り使い続けられる）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Home Assistant連携（家電操作・室温湿度ウィジェット）
# トークンはHAの「プロフィール → セキュリティ → 長期アクセストークン」で発行する
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=
# 解錠は、画面からはログインしたアカウントなら、音声アシスタントからは画面で本人確認して許可したときだけできる

# iMessage（Mac の imsg-web。設定画面の「拡張機能 → iMessage」でも入れられ、そちらが優先される）
# トークンは Mac で `imsg-web client add dashboard`（送るなら --send）を実行して出す。
# 証明書は imsg-web の state/tls/cert.pem の中身（1行にしてよい）か、config/imessage/cert.pem に置く。
# Docker の中からは .local の名前が引けないことがあるので、Mac の IP アドレスか Tailscale Serve の名前でつなぐ
# IMSG_WEB_URL=https://192.168.1.10:8787
# IMSG_WEB_TOKEN=
# IMSG_WEB_CERT=

# インターネットアカウント（Google・iCloud・Microsoft・一般。設定の「アカウント → インターネットアカウント」で各自が足す）
# Google・Microsoft でログインして足すときだけ、管理者がここか「拡張機能 → カレンダー・メール」で決める。docs/internet-accounts.md 参照
# ACCOUNTS_REDIRECT_BASE は、このダッシュボードを開いている https の URL（各サービスに …/auth/accounts/<google|microsoft>/callback を登録する）
ACCOUNTS_REDIRECT_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# 前のメール（IMAP）の設定。書いてあれば、インターネットアカウントの「家のアカウント」（家で共有・管理者が変える）として一度だけ移す。
# 新しく足すなら、ここではなく設定の「アカウント → インターネットアカウント」から足す
MAIL_HOST=
MAIL_PORT=993
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=

# Claude の利用制限を statusLine から送るスクリプト（scripts/claude-limits-report.sh）の合言葉。
# 同じ値を ~/.config/home-dashboard/claude-limits-token に置く。空だと利用制限を受け取らない（例: openssl rand -hex 32）
CLAUDE_LIMITS_TOKEN=

# 以下はDocker運用時にdocker-compose.ymlから渡されるので、通常この.envに書く必要はない
# （開発時にホスト上で直接起動する場合は既定値
#   ~/.claude/projects ・ ~/Documents/git-cloned ・ /var/run/tailscale/tailscaled.sock が使われる）
# CLAUDE_PROJECTS_DIR=
# GIT_REPOS_DIR=
# TAILSCALE_SOCKET=

# 音声アシスタント（apps/voice-agent）用のエンドポイント（/ws/voice-agent と、Claude に渡すツールの /mcp）の共有トークン。
# apps/voice-agent/.env の VOICE_AGENT_TOKEN にも同じ値を入れる。エージェントはこれで会話の記録・添付・道具の確かめの道も読む
# （ダッシュボードはログインが要るので、未設定だとエージェントが会話の履歴を読めない）。ほかの /api/* には入れない。
VOICE_AGENT_TOKEN=

# ウェイクワードごとに呼び分けるキャラクターを置くディレクトリ（既定は config/voice-personas）。
# 設定画面からのインポート・削除でここに書き込む
# VOICE_PERSONAS_DIR=
# キャラクター設定が無いときに応答パネルに出すVRMアバター（既定は config/avatar.vrm。無ければ出さない）
# VOICE_AVATAR_PATH=

# 拡張機能のリポジトリ（設定画面の「拡張機能 → リポジトリ」）。まだ一度も登録していないときだけ、起動時にこれを登録する。
# 公開用の枝（dist-extensions）は `pnpm publish:extensions --push`（か GitHub Actions）が置く。docs/extensions.md 参照
# 非公開のリポジトリなら、読むためのトークン（GitHub なら Contents を読むだけの fine-grained token）も入れる（画面で入れてもよい）
EXTENSION_SOURCE_URL=
EXTENSION_SOURCE_BRANCH=dist-extensions
EXTENSION_SOURCE_TOKEN=
EXTENSION_SOURCE_NAME=
