PORT=8787

# 天気ウィジェット（Open-Meteo、APIキー不要）
WEATHER_LAT=35.6895
WEATHER_LON=139.6917
WEATHER_LOCATION_NAME=Tokyo

# Spotifyメディアウィジェット
# 1. https://developer.spotify.com/dashboard でアプリを作成し、
#    Redirect URI に SPOTIFY_REDIRECT_URI と同じ値を登録する
# 2. CLIENT_ID/SECRET/REDIRECT_URIを設定してサーバーを起動
# 3. ブラウザで http://<server>:8787/auth/spotify/login を開いて認可
# 4. コールバック画面に表示されたrefresh tokenをSPOTIFY_REFRESH_TOKENに設定して再起動
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=
