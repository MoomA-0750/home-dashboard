PORT=8787

# 天気ウィジェット（Open-Meteo、APIキー不要）
WEATHER_LAT=35.6895
WEATHER_LON=139.6917
WEATHER_LOCATION_NAME=Tokyo

# Spotifyメディアウィジェット
# SpotifyはRedirect URIに https か、リテラルの 127.0.0.1（localhostは不可）以外を許可しない。
# サーバーをリモートホスト(gco等)で動かす場合、初回認可のときだけSSHポートフォワードで
# ローカルの127.0.0.1経由にするのが手軽（詳細はREADMEの「Spotify連携のセットアップ」参照）。
# 1. https://developer.spotify.com/dashboard でアプリを作成し、
#    Redirect URI に SPOTIFY_REDIRECT_URI と同じ値(http://127.0.0.1:8787/auth/spotify/callback)を登録する
# 2. CLIENT_ID/SECRET/REDIRECT_URIを設定してサーバーを起動
# 3. `ssh -L 8787:localhost:8787 gco` 等でトンネルしてから、
#    手元のブラウザで http://127.0.0.1:8787/auth/spotify/login を開いて認可
# 4. コールバック画面に表示されたrefresh tokenをSPOTIFY_REFRESH_TOKENに設定して再起動
#    （以降はトンネル不要。refresh tokenはSpotifyがrevokeしない限り使い続けられる）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Home Assistant連携（家電操作・室温湿度ウィジェット）
# トークンはHAの「プロフィール → セキュリティ → 長期アクセストークン」で発行する
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=
# 玄関錠などの「解錠」を許可するか。
# このダッシュボードはLAN上に認証なしで公開される前提のため既定はfalse（状態表示と施錠のみ）。
# trueにするとLANに入れる誰でも解錠できてしまう点に注意。
HOMEASSISTANT_ALLOW_UNLOCK=false

# メール（IMAP）ウィジェット
# 未設定なら「メール未接続」と表示されるだけで、他のウィジェットには影響しない。
# Gmailの場合は2段階認証を有効にした上で https://myaccount.google.com/apppasswords で
# 「アプリパスワード」を発行する（通常のアカウントのパスワードではIMAPログインできない）。
#   MAIL_HOST=imap.gmail.com
#   MAIL_USER=you@gmail.com
# 受信箱以外を見たい場合は MAIL_MAILBOX を変える（Gmailのラベルは "[Gmail]/重要" のように指定する）
MAIL_HOST=
MAIL_PORT=993
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_MAILBOX=INBOX

# 以下はDocker運用時にdocker-compose.ymlから渡されるので、通常この.envに書く必要はない
# （開発時にホスト上で直接起動する場合は既定値
#   ~/.claude/projects ・ ~/Documents/git-cloned ・ /var/run/tailscale/tailscaled.sock が使われる）
# CLAUDE_PROJECTS_DIR=
# GIT_REPOS_DIR=
# TAILSCALE_SOCKET=

# 音声アシスタント（apps/voice-agent）用のエンドポイント（/ws/voice-agent と、Claude に渡すツールの /mcp）の共有トークン。
# 設定する場合は apps/voice-agent/.env の VOICE_AGENT_TOKEN にも同じ値を入れる。
# 未設定なら LAN 内から誰でも使える（/mcp でできることは既存の /api/* と同じ範囲）
VOICE_AGENT_TOKEN=
