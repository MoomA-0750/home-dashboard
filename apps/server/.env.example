PORT=8787

# 天気ウィジェット（Open-Meteo、APIキー不要）
WEATHER_LAT=35.6895
WEATHER_LON=139.6917
WEATHER_LOCATION_NAME=Tokyo

# Spotifyメディアウィジェット
# SpotifyはRedirect URIに https か、リテラルの 127.0.0.1（localhostは不可）以外を許可しない。
# サーバーをリモートホスト(gco等)で動かす場合、初回認可のときだけSSHポートフォワードで
# ローカルの127.0.0.1経由にするのが手軽（詳細はREADMEの「Spotify連携のセットアップ」参照）。
# 1. https://developer.spotify.com/dashboard でアプリを作成し、
#    Redirect URI に SPOTIFY_REDIRECT_URI と同じ値(http://127.0.0.1:8787/auth/spotify/callback)を登録する
# 2. CLIENT_ID/SECRET/REDIRECT_URIを設定してサーバーを起動
# 3. `ssh -L 8787:localhost:8787 gco` 等でトンネルしてから、
#    手元のブラウザで http://127.0.0.1:8787/auth/spotify/login を開いて認可
# 4. コールバック画面に表示されたrefresh tokenをSPOTIFY_REFRESH_TOKENに設定して再起動
#    （以降はトンネル不要。refresh tokenはSpotifyがrevokeしない限り使い続けられる）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_REFRESH_TOKEN=
