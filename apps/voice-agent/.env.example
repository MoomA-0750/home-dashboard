# 音声アシスタントの設定。cp .env.example .env して使う（未指定の項目は既定値）

# ダッシュボードのサーバー。apps/server/.env で VOICE_AGENT_TOKEN を設定したら同じ値を入れる
VOICE_SERVER_URL=http://127.0.0.1:8787
VOICE_AGENT_TOKEN=

# --- マイク・スピーカー ---
# 16kHz mono s16le を標準出力に流し続けるコマンド。USBマイクを明示するなら `arecord -l` で番号を調べて
#   VOICE_INPUT_CMD=arecord -q -D plughw:1,0 -t raw -f S16_LE -r 16000 -c 1
VOICE_INPUT_CMD=arecord -q -t raw -f S16_LE -r 16000 -c 1
# WAVを標準入力で受け取って再生するコマンド
VOICE_OUTPUT_CMD=aplay -q -
# ウェイクワードを受け付けたとき・聞き取れなかったときにチャイムを鳴らすか
VOICE_CHIME=true

# --- ウェイクワード（Vosk） ---
# Voskの日本語モデルの単語区切りで書く。語彙に無い語は黙って無視されるので、変えたら検出できるか確認すること
VOICE_WAKE_PHRASE=ねえ クロード
# ウェイクワードと音の似た語（誤検出を吸わせるおとり）。READMEの「ウェイクワードの誤検出対策」参照
# VOICE_WAKE_DECOYS=クローゼット クローバー クロール クローン クロス 黒 モネ ですね あのね 寝る ね
# VOICE_VOSK_MODEL_DIR=~/.cache/home-dashboard-voice/vosk-model-small-ja-0.22

# ウェイクワードだけ言われたとき、命令を待つ秒数
VOICE_LISTEN_TIMEOUT_S=6
# 声が途切れてからこの秒数で話し終えたとみなす
VOICE_END_SILENCE_S=1.0
VOICE_MAX_UTTERANCE_S=20

# --- 書き起こし（faster-whisper） ---
# tiny / base / small / medium。CPUにAVX2があるなら small の方が精度が良い（README参照）
VOICE_WHISPER_MODEL=base
VOICE_WHISPER_COMPUTE_TYPE=int8

# --- Claude Code ---
# systemdから起動する場合はPATHが通っていないことがあるので絶対パスにする
VOICE_CLAUDE_BIN=claude
VOICE_CLAUDE_MODEL=sonnet
# 使わせるツール（カンマ区切り）。部屋にいる誰の声でも動くので、Bash/Edit/Write等は入れないこと
VOICE_CLAUDE_TOOLS=WebSearch,WebFetch
# ダッシュボードの天気・家電（Home Assistant）・音楽（Spotify）をツールとして使わせるか（サーバーの /mcp）
VOICE_DASHBOARD_MCP=true
# 最後のやり取りからこの秒数以内なら、同じ会話の続きとして扱う
VOICE_SESSION_IDLE_S=300
VOICE_CLAUDE_TIMEOUT_S=180
# VOICE_CLAUDE_CWD=~/.local/share/home-dashboard-voice/workspace

# --- 読み上げ（VOICEVOX Engine） ---
VOICEVOX_URL=http://127.0.0.1:50021
# 話者のスタイルID（http://127.0.0.1:50021/speakers で一覧できる。3 = ずんだもん ノーマル）
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.1
