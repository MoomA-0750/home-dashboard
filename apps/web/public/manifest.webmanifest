{
  "name": "Home Dashboard",
  "short_name": "Dashboard",
  "description": "家の壁掛け端末・スマホで使うホームダッシュボード",
  "lang": "ja",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
